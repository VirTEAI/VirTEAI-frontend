VITE_API_URL=http://localhost:4000

# Em produção (Vercel), configure essa variável no painel do projeto
# (Settings -> Environment Variables) apontando pra URL do backend no
# Render, ex.: VITE_API_URL=https://virteai-server.onrender.com
# Ela é lida em build time (import.meta.env), então depois de mudar é
# preciso rodar um novo deploy pra valer.
